# 密钥（不进仓库）
.env
.env.*
!.env.example
backend/config.yaml

# Python 环境与缓存
.venv/
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# 前端依赖与构建
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
*.tsbuildinfo

# 运行时数据
data/
backend/data/

# 随源码交付的三张默认模板；其余运行时数据仍忽略
!backend/data/
backend/data/*
!backend/data/templates/
backend/data/templates/*
!backend/data/templates/tpl_1.png
!backend/data/templates/tpl_2.png
!backend/data/templates/tpl_3.png
backend/code/
backend/temp/
backend/logs/

# 系统
.DS_Store
