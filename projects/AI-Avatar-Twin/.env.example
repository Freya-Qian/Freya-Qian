# 复制为 .env 并填入真实 Key（.env 不入库）
# 模型：阿里云百炼 DashScope（OpenAI 兼容），与「脑洞游戏」同平台可复用同一 Key
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_TIMEOUT=60
MODEL_MAX_RETRIES=2

# 本地开发：验证码直接返回给前端显示（真实短信上线前用 true）
DEV_MODE=true
TOKEN_TTL_DAYS=7

# 数字人视频：TTS（留空 TTS_API_KEY 时复用 MODEL_API_KEY；未配/失败时降级静音音频）
TTS_ENABLED=true
TTS_API_KEY=
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_MODEL=cosyvoice-v2
TTS_VOICE=longxiaochun_v2

# 数字人口型驱动（万相-数字人 wan2.2-s2v，按秒计费，有免费额度）
DIGITAL_HUMAN_ENABLED=true
DIGITAL_HUMAN_API_KEY=
DIGITAL_HUMAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DIGITAL_HUMAN_MODEL=wan2.2-s2v
DIGITAL_HUMAN_RESOLUTION=480P
DIGITAL_HUMAN_SEGMENT=60

# 口播脚本默认时长（秒），先做 30 秒，60 秒后续再开
SCRIPT_DURATION=30

# 火山引擎即梦数字人（OmniHuman，优先于阿里云万相-数字人）
JIMENG_ENABLED=true
VOLCENGINE_AK=
VOLCENGINE_SK=

# 照片→3D 风格化（通义万相参考生图，留空 STYLIZE_API_KEY 时复用 MODEL_API_KEY；失败降级原照片）
STYLIZE_ENABLED=true
STYLIZE_API_KEY=
STYLIZE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
STYLIZE_MODEL=wan2.6-image

