# 复制为 .env 并填入真实 Key（.env 不入库）
# 模型：国内厂商优先（数据不出境），用户自备 API Key；默认阿里云百炼 DashScope（OpenAI 兼容）
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=2

# 单项目 token 预算上限（元，软护栏：超限提醒、不硬断；可配置）
PROJECT_BUDGET_CNY=10

# 本地单机模式（MVP）：匿名本地用户 + SQLite 持久化
DEV_MODE=true
